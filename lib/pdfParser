// ============================================================
//  lib/pdfParser.js — อ่าน PDF บิลค่าส่ง แล้วดึงข้อมูลพัสดุ
//  รองรับ: Flash Express, EMS (ไปรษณีย์ไทย)
//  - ใช้ Claude Vision API ทุกกรณี (แม่นยำกว่า regex)
// ============================================================

// ──────────────────────────────────────────────
//  🔍 Main: รับ Buffer → คืน { date, parcels[] }
// ──────────────────────────────────────────────
async function parseBillPDF(buffer) {
  console.log('Sending PDF to Claude Vision...');
  return parsePDFWithClaude(buffer);
}

// ──────────────────────────────────────────────
//  🤖 Claude Vision fallback สำหรับ image PDF
// ──────────────────────────────────────────────
async function parsePDFWithClaude(buffer) {
  const apiKey = process.env.ANTHROPIC_API_KEY;
  if (!apiKey) throw new Error('ไม่มี ANTHROPIC_API_KEY — กรุณาเพิ่มใน Vercel Environment Variables');

  const base64 = buffer.toString('base64');

  const res = await fetch('https://api.anthropic.com/v1/messages', {
    method: 'POST',
    headers: {
      'Content-Type':      'application/json',
      'x-api-key':         apiKey,
      'anthropic-version': '2023-06-01',
    },
    body: JSON.stringify({
      model:      'claude-haiku-4-5-20251001',
      max_tokens: 1024,
      messages: [{
        role: 'user',
        content: [
          {
            type:   'document',
            source: { type: 'base64', media_type: 'application/pdf', data: base64 },
          },
          {
            type: 'text',
            text: `นี่คือบิลค่าส่งพัสดุ Flash Express หรือ EMS อ่านและดึงข้อมูลพัสดุทุกรายการ

โครงสร้างบิล (แต่ละส่วนตามลำดับจากบนลงล่าง):

ส่วนที่ 1 — หัวบิล (บรรทัดแรกๆ ของเอกสาร):
  ชื่อเจ้าของสาขา / รหัสสาขา / เบอร์ติดต่อ XXXXXXXXXX
  ⚠️ ชื่อและเบอร์ในหัวบิลเป็นของสาขา ไม่ใช่ผู้รับพัสดุ ห้ามนำมาใช้เด็ดขาด

ส่วนที่ 2 — รายการพัสดุแต่ละชิ้น:
  บรรทัด A: เลขพัสดุ (เช่น TH47158WUBVH8A)  ราคา บ.
  บรรทัด B: ค่าขนส่ง / Speed / ค่าน้ำมัน / น้ำหนัก (ข้ามได้)
  บรรทัด C: "ผู้รับ" ตามด้วยชื่อผู้รับ — มี 2 รูปแบบ:
    • รูปแบบ 1: "ผู้รับ [ชื่อ] [เบอร์10หลัก]" — ชื่อและเบอร์อยู่บรรทัดเดียวกัน
    • รูปแบบ 2: "ผู้รับ [ชื่อ]" แล้วบรรทัดถัดไปเป็นเบอร์ 10 หลักแยกต่างหาก
  บรรทัด D: ที่อยู่ผู้รับ + รหัสไปรษณีย์

กฎการดึงข้อมูล:
- "date" = วันที่บนบิล รูปแบบ DD/MM/YYYY
- "tracking" = เลขพัสดุ คัดลอกทุกตัวอักษรให้ถูกต้อง เช่น TH47158WUBVH8A
- "courier" = ชื่อขนส่ง เช่น Flash Express, EMS
- "recipient" = ชื่อผู้รับ ตัด "ผู้รับ " นำหน้าออก และตัดเบอร์ออก เช่น "คุณเทวินทร์ วิธี"
- "phone" = เบอร์ 10 หลักของผู้รับ (อยู่ในบรรทัด C หรือ D ก็ได้) — ต้องอยู่ในส่วนพัสดุ ไม่ใช่หัวบิล
- "address" = ที่อยู่จัดส่งจริง เช่น "หางดง หางดง 50230" — ใส่ชื่อสถานที่จริง

ตอบเป็น JSON array เท่านั้น:
[{"date":"...","tracking":"...","courier":"...","recipient":"...","phone":"...","address":"..."}]

ถ้าไม่พบพัสดุให้ตอบ []`,
          },
        ],
      }],
    }),
  });

  if (!res.ok) {
    const err = await res.text();
    throw new Error('Claude API error: ' + err.slice(0, 200));
  }

  const json    = await res.json();
  const content = json?.content?.[0]?.text || '[]';
  console.log('Claude response:', content.slice(0, 300));

  let parcels = [];
  try {
    parcels = JSON.parse(content.match(/\[[\s\S]*\]/)?.[0] || '[]');
  } catch (e) {
    console.error('JSON parse error:', e.message);
  }

  // ดึง date จาก parcel หรือ content
  const date = parcels[0]?.date || content.match(/(\d{2}\/\d{2}\/\d{4})/)?.[1] || '';
  // ลบ date field ออกจาก parcel objects (เก็บไว้ที่ระดับ top เท่านั้น)
  parcels.forEach(p => delete p.date);

  return { date, parcels };
}

// ──────────────────────────────────────────────
//  📝 Format แยกเป็นข้อความทีละรายการ (array of string)
// ──────────────────────────────────────────────
function formatParcels({ date, parcels }) {
  if (parcels.length === 0) {
    return ['❌ ไม่พบข้อมูลพัสดุในไฟล์นี้ค่ะ\nกรุณาตรวจสอบว่าส่งไฟล์ PDF บิลค่าส่งถูกต้องหรือไม่'];
  }

  const dateStr = date ? ` ${date}` : '';
  const messages = [];

  for (let i = 0; i < parcels.length; i++) {
    const p = parcels[i];

    // Bubble 1: ข้อมูลพัสดุ
    const info = [
      `📦 พัสดุที่ ${i + 1}/${parcels.length}${dateStr}`,
      '─'.repeat(24),
      `🚚 ขนส่ง   : ${p.courier   || '-'}`,
      `👤 ผู้รับ   : ${p.recipient || '-'}`,
      `☎️  เบอร์   : ${p.phone     || '-'}`,
      `📍 ที่อยู่  : ${p.address   || '-'}`,
      '─'.repeat(24),
      '🏪 ร้าน ซี.เค.แอร์คอนด์',
    ];
    messages.push(info.join('\n'));

    // Bubble 2: เลขพัสดุอย่างเดียว → กดค้างคัดลอกได้ทันที
    messages.push(`📮 เลขพัสดุ :\n${p.tracking || '-'}`);
  }

  return messages;
}

module.exports = { parseBillPDF, formatParcels };
