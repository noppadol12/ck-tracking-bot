// ============================================================
//  lib/pdfParser.js — ดึงเลขพัสดุ + ชื่อผู้รับ จาก PDF บิลค่าส่ง
//
//  1) อ่าน text layer (ฟรี)
//     • เลขพัสดุ: regex → แม่นที่สุด ใช้เป็น "ความจริง"
//     • ชื่อผู้รับ: ใช้ได้เฉพาะเมื่อภาษาไทยในไฟล์ไม่เสีย
//  2) ถ้าไม่มี text / ภาษาไทยเสีย → Claude Vision
//     • ให้ "คัดลอกบรรทัดผู้รับตามตัวอักษร" แล้วโค้ดตัดชื่อเอง
//     • บังคับตอบผ่าน tool (JSON ไม่พัง)
//     • ตรวจซ้ำ: เลขพัสดุต้องตรงรูปแบบ / ชื่อต้องไม่ใช่ชื่อหัวบิล
// ============================================================

const pdfParse = require('pdf-parse');

const VISION_MODEL = process.env.VISION_MODEL || 'claude-sonnet-5-5';

const FLASH_RX = /(TH[A-Z0-9]{10,}?)(?=[1-9]\d*\.\d{2}|\s|$)/;
const EMS_RX   = /([A-Z]{2}\d{9}TH)/;
const PHONE_RX = /0\d{1,2}[-\s]?\d{3}[-\s]?\d{4}/;

// ──────────────────────────────────────────────
//  🔍 Main → [{ tracking, recipient }]
// ──────────────────────────────────────────────
async function parseBillPDF(buffer) {
  let text = '';
  try {
    text = ((await pdfParse(buffer)).text || '').trim();
  } catch (e) {
    console.error('pdf-parse error:', e.message);
  }

  const textParcels = text.length > 20 ? extractFromText(text) : [];
  console.log('Text parcels:', JSON.stringify(textParcels));

  // ได้ชื่อที่เชื่อถือได้ครบทุกชิ้น → จบ ไม่เสีย API
  if (textParcels.length > 0 && textParcels.every(p => p.trusted)) {
    return textParcels.map(({ tracking, recipient }) => ({ tracking, recipient }));
  }

  // ต้องใช้ Vision
  let vision = [];
  try {
    vision = await parseWithVision(buffer);
  } catch (e) {
    console.error('Vision error:', e.message);
    if (textParcels.length) return textParcels; // อย่างน้อยยังมีเลขพัสดุ
    throw e;
  }
  console.log('Vision parcels:', JSON.stringify(vision));

  // มีเลขพัสดุจาก text → ใช้เลขจาก text เป็นหลัก แล้วเติมชื่อจาก vision
  if (textParcels.length > 0) {
    return textParcels.map((p, i) => {
      const match = vision.find(v => v.tracking === p.tracking) || vision[i];
      return { tracking: p.tracking, recipient: match?.recipient || p.recipient || '' };
    });
  }
  return vision;
}

// ──────────────────────────────────────────────
//  📦 ดึงจาก text layer
// ──────────────────────────────────────────────
function extractFromText(text) {
  const lines = text.split('\n').map(l => l.trim()).filter(Boolean);
  const out   = [];
  const seen  = new Set();

  for (let i = 0; i < lines.length; i++) {
    const m = lines[i].match(FLASH_RX) || lines[i].match(EMS_RX);
    if (!m || seen.has(m[1])) continue;
    seen.add(m[1]);

    let recipient = '';
    let trusted   = false;
    for (let j = i + 1; j < Math.min(lines.length, i + 10); j++) {
      if (FLASH_RX.test(lines[j]) || EMS_RX.test(lines[j])) break;
      if (/^ผู้รับ/u.test(lines[j])) {
        recipient = cleanName(lines[j]);
        // เชื่อได้เมื่อ: ไม่มีตัวอักษรเสีย และบรรทัดจบด้วยเบอร์ (หรือบรรทัดถัดไปเป็นเบอร์)
        const hasPhone = PHONE_RX.test(lines[j]) || PHONE_RX.test(lines[j + 1] || '');
        trusted = !!recipient && hasPhone && !isThaiDamaged(lines[j]);
        break;
      }
    }
    out.push({ tracking: m[1], recipient: trusted ? recipient : '', trusted });
  }
  return out;
}

// ภาษาไทยใน text layer เสีย? (ฟอนต์บางตัวทำสระ/วรรณยุกต์หาย เช่น "น ามัน")
function isThaiDamaged(text) {
  return /[ก-ฮ] [ะ-ฺๅ-๎]/u.test(text) // พยัญชนะ + ช่องว่าง + สระที่ขึ้นต้นคำไม่ได้
      || /[฀-๿] {2,}/u.test(text)                          // ช่องว่างซ้อนหลังตัวไทย
      || /[\u0000�]/.test(text);                               // ตัวอักษรที่ฟอนต์แปลงไม่ได้
}

// "ผู้รับ คุณเทวินทร์ วิธี 0992564454" → "คุณเทวินทร์ วิธี"
function cleanName(line) {
  return String(line || '')
    .replace(/^\s*ผู้รับ\s*[:：]?\s*/u, '')
    .replace(new RegExp(PHONE_RX.source + '.*$'), '')
    .replace(/0\d{8,9}.*$/, '')
    .replace(/\s+/g, ' ')
    .trim();
}

// ──────────────────────────────────────────────
//  🤖 Claude Vision (บังคับตอบผ่าน tool)
// ──────────────────────────────────────────────
async function parseWithVision(buffer) {
  const apiKey = process.env.ANTHROPIC_API_KEY;
  if (!apiKey) throw new Error('ไม่มี ANTHROPIC_API_KEY');

  const tool = {
    name: 'report_bill',
    description: 'ส่งข้อมูลที่คัดลอกจากบิลค่าส่ง',
    input_schema: {
      type: 'object',
      properties: {
        branch_name: {
          type: 'string',
          description: 'ชื่อบุคคลในหัวบิล (บรรทัดถัดจาก "ใบเสร็จรับเงิน") — เป็นเจ้าของสาขา ไม่ใช่ผู้รับ',
        },
        parcels: {
          type: 'array',
          items: {
            type: 'object',
            properties: {
              tracking: { type: 'string', description: 'เลขพัสดุ คัดลอกทีละตัวอักษร' },
              recipient_line: {
                type: 'string',
                description: 'คัดลอกบรรทัดที่ขึ้นต้นด้วย "ผู้รับ" ของพัสดุชิ้นนี้ แบบตัวต่อตัว ห้ามแก้คำ ห้ามเดา',
              },
            },
            required: ['tracking', 'recipient_line'],
          },
        },
      },
      required: ['branch_name', 'parcels'],
    },
  };

  const res = await fetch('https://api.anthropic.com/v1/messages', {
    method: 'POST',
    headers: {
      'Content-Type':      'application/json',
      'x-api-key':         apiKey,
      'anthropic-version': '2023-06-01',
    },
    body: JSON.stringify({
      model:       VISION_MODEL,
      max_tokens:  1024,
      tools:       [tool],
      tool_choice: { type: 'auto' }, // รุ่นใหม่ไม่รองรับการบังคับ tool → ใช้ auto + สั่งใน prompt
      messages: [{
        role: 'user',
        content: [
          { type: 'document', source: { type: 'base64', media_type: 'application/pdf', data: buffer.toString('base64') } },
          {
            type: 'text',
            text: `นี่คือใบเสร็จค่าส่งพัสดุ (Flash Express / ไปรษณีย์ไทย)

โครงสร้าง:
- หัวบิล: "ใบเสร็จรับเงิน" → ชื่อเจ้าของสาขา → รหัสสาขา → เบอร์ติดต่อ  (ไม่ใช่ผู้รับ)
- แต่ละรายการ: "ผู้ส่ง ..." → "ขนส่ง: ..." → เลขพัสดุ + ราคา → ค่าขนส่ง/Speed/ค่าน้ำมัน/น้ำหนัก → "ผู้รับ [ชื่อ] [เบอร์]" → ที่อยู่
- รายการ "ส่งใบเสร็จทาง SMS" ไม่ใช่พัสดุ ไม่ต้องใส่

คัดลอกข้อความตามที่เห็นจริงทีละตัวอักษร ระวังวรรณยุกต์และสระภาษาไทย
จากนั้นต้องเรียก tool report_bill ทันที ห้ามตอบเป็นข้อความธรรมดา`,
          },
        ],
      }],
    }),
  });

  if (!res.ok) throw new Error('Claude API ' + res.status + ': ' + (await res.text()).slice(0, 200));

  const json  = await res.json();
  let input = json?.content?.find(c => c.type === 'tool_use')?.input;

  // สำรอง: ถ้าโมเดลตอบเป็นข้อความแทนการเรียก tool → หา JSON ในข้อความ
  if (!input) {
    const txt = (json?.content || []).filter(c => c.type === 'text').map(c => c.text).join('\n');
    console.log('No tool_use, text:', txt.slice(0, 300));
    try { input = JSON.parse(txt.match(/\{[\s\S]*\}/)?.[0] || '{}'); } catch { input = {}; }
  }
  const branch = cleanName(input.branch_name || '');

  return (input.parcels || [])
    .map(p => ({
      tracking:  String(p.tracking || '').toUpperCase().replace(/\s+/g, ''),
      recipient: cleanName(p.recipient_line),
    }))
    .filter(p => /^TH[A-Z0-9]{10,16}$/.test(p.tracking) || /^[A-Z]{2}\d{9}TH$/.test(p.tracking))
    .map(p => ({
      ...p,
      // กันชื่อหัวบิลหลุดมาเป็นชื่อผู้รับ
      recipient: branch && p.recipient && (p.recipient.includes(branch) || branch.includes(p.recipient)) ? '' : p.recipient,
    }));
}

// ──────────────────────────────────────────────
//  📝 Format: bubble ละ 1 พัสดุ
// ──────────────────────────────────────────────
function formatTrackings(parcels) {
  if (!parcels || parcels.length === 0) {
    return ['❌ ไม่พบเลขพัสดุในไฟล์นี้ค่ะ\nกรุณาตรวจสอบว่าส่งไฟล์ PDF บิลค่าส่งถูกต้องหรือไม่'];
  }
  return parcels.map((p, i) => {
    const lines = [`📮 พัสดุที่ ${i + 1}/${parcels.length}`];
    if (p.recipient) lines.push(`👤 ${p.recipient}`);
    lines.push(p.tracking);
    return lines.join('\n');
  });
}

module.exports = { parseBillPDF, formatTrackings, _test: { extractFromText, isThaiDamaged, cleanName } };
