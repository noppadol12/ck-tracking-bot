// ============================================================
//  lib/pdfParser.js — ดึงเลขพัสดุ + ชื่อผู้รับ จาก PDF บิลค่าส่ง
//  - PDF มี text layer → regex (ประหยัด quota)
//  - PDF เป็น image → Claude Vision API (fallback)
// ============================================================

const pdfParse = require('pdf-parse');

// ──────────────────────────────────────────────
//  🔍 Main: รับ Buffer → คืน array ของ { tracking, recipient }
// ──────────────────────────────────────────────
async function parseBillPDF(buffer) {
  const data = await pdfParse(buffer);
  const text = (data.text || '').trim();
  console.log('PDF text length:', text.length);

  if (text.length > 20) {
    const parcels = extractParcels(text);
    if (parcels.length > 0) {
      console.log('Regex found:', parcels);
      return parcels;
    }
  }

  // Image PDF → Claude Vision
  console.log('Image PDF → Claude Vision');
  return parsePDFWithClaude(buffer);
}

// ──────────────────────────────────────────────
//  📦 Regex: ดึงเลขพัสดุ + ชื่อผู้รับ จาก text
// ──────────────────────────────────────────────
function extractParcels(text) {
  const lines  = text.split('\n').map(l => l.trim()).filter(Boolean);
  const flashRx = /(TH[A-Z0-9]{10,}?)(?=[1-9]\d*\.\d{2}|\s|$)/;
  const emsRx   = /([A-Z]{2}\d{8,}TH)/;
  const anyRx   = (line) => line.match(flashRx) || line.match(emsRx);

  const parcels = [];
  const seen    = new Set();

  for (let i = 0; i < lines.length; i++) {
    const tm = anyRx(lines[i]);
    if (!tm) continue;

    const tracking = tm[1];
    if (seen.has(tracking)) continue;
    seen.add(tracking);

    // หาชื่อผู้รับ (ดูข้างหน้า 8 บรรทัด)
    let recipient = '';
    for (let j = i + 1; j < Math.min(lines.length, i + 9); j++) {
      if (anyRx(lines[j])) break;

      // "ผู้รับ [ชื่อ]" หรือ "ผู้รับ [ชื่อ] [เบอร์]"
      const m = lines[j].match(/^ผู้รับ\s+(.+)/u);
      if (m) {
        recipient = m[1]
          .replace(/\s*0\d{9}.*$/u, '')  // ตัดเบอร์โทรออก
          .trim();
        break;
      }
    }

    parcels.push({ tracking, recipient });
  }

  return parcels;
}

// ──────────────────────────────────────────────
//  🤖 Claude Vision fallback สำหรับ image PDF
// ──────────────────────────────────────────────
async function parsePDFWithClaude(buffer) {
  const apiKey = process.env.ANTHROPIC_API_KEY;
  if (!apiKey) throw new Error('ไม่มี ANTHROPIC_API_KEY — กรุณาเพิ่มใน Vercel Environment Variables');

  const base64 = buffer.toString('base64');

  const res = await fetch('https://api.anthropic.com/v1/messages', {
    method: 'POST',
    headers: {
      'Content-Type':      'application/json',
      'x-api-key':         apiKey,
      'anthropic-version': '2023-06-01',
    },
    body: JSON.stringify({
      model:      'claude-haiku-4-5-20251001',
      max_tokens: 512,
      messages: [{
        role: 'user',
        content: [
          {
            type:   'document',
            source: { type: 'base64', media_type: 'application/pdf', data: base64 },
          },
          {
            type: 'text',
            text: `นี่คือบิลค่าส่งพัสดุ ดึงข้อมูลพัสดุทุกชิ้น

หัวบิล (ชื่อเจ้าของสาขา + เบอร์ติดต่อ) — ไม่ต้องการ
รายการพัสดุแต่ละชิ้น:
  - เลขพัสดุ (เช่น TH47158WUBVH8A)
  - ชื่อผู้รับ (บรรทัดที่ขึ้นต้นด้วย "ผู้รับ" — ตัด "ผู้รับ" และเบอร์โทรออก)

ตอบเป็น JSON array เท่านั้น:
[{"tracking":"TH47158WUBVH8A","recipient":"คุณเทวินทร์ วิธี"}]
ถ้าไม่พบตอบ []`,
          },
        ],
      }],
    }),
  });

  if (!res.ok) {
    const err = await res.text();
    throw new Error('Claude API error: ' + err.slice(0, 200));
  }

  const json    = await res.json();
  const content = json?.content?.[0]?.text || '[]';
  console.log('Claude response:', content);

  try {
    const arr = JSON.parse(content.match(/\[[\s\S]*\]/)?.[0] || '[]');
    return arr
      .filter(p => p && typeof p.tracking === 'string' && p.tracking.length > 5)
      .map(p => ({ tracking: p.tracking, recipient: p.recipient || '' }));
  } catch (e) {
    console.error('JSON parse error:', e.message);
    return [];
  }
}

// ──────────────────────────────────────────────
//  📝 Format: แยกเป็น bubble ละ 1 พัสดุ
// ──────────────────────────────────────────────
function formatTrackings(parcels) {
  if (parcels.length === 0) {
    return ['❌ ไม่พบเลขพัสดุในไฟล์นี้ค่ะ\nกรุณาตรวจสอบว่าส่งไฟล์ PDF บิลค่าส่งถูกต้องหรือไม่'];
  }

  return parcels.map((p, i) => {
    const lines = [`📮 พัสดุที่ ${i + 1}/${parcels.length}`];
    if (p.recipient) lines.push(`👤 ${p.recipient}`);
    lines.push(p.tracking);
    return lines.join('\n');
  });
}

module.exports = { parseBillPDF, formatTrackings };
