// ============================================================
//  lib/pdfParser.js — ดึงเลขพัสดุจาก PDF บิลค่าส่ง
//  - PDF มี text layer → regex (ประหยัด quota)
//  - PDF เป็น image → Claude Vision API (fallback)
// ============================================================

const pdfParse = require('pdf-parse');

// ──────────────────────────────────────────────
//  🔍 Main: รับ Buffer → คืน array ของเลขพัสดุ
// ──────────────────────────────────────────────
async function parseBillPDF(buffer) {
  const data = await pdfParse(buffer);
  const text = (data.text || '').trim();
  console.log('PDF text length:', text.length);

  if (text.length > 20) {
    const trackings = extractTrackingNumbers(text);
    if (trackings.length > 0) {
      console.log('Regex found:', trackings);
      return trackings;
    }
  }

  // Image PDF → Claude Vision
  console.log('Image PDF → Claude Vision');
  return parsePDFWithClaude(buffer);
}

// ──────────────────────────────────────────────
//  📦 Regex: ดึงเลขพัสดุจาก text
// ──────────────────────────────────────────────
function extractTrackingNumbers(text) {
  const results = new Set();

  // Flash Express: TH + ตัวอักษร/ตัวเลข ≥10 ตัว (หยุดก่อนราคา เช่น 43.00)
  const flashRx = /(TH[A-Z0-9]{10,}?)(?=[1-9]\d*\.\d{2}|\s|$)/g;
  // EMS: 2 ตัวอักษร + ตัวเลข 8+ + TH
  const emsRx = /([A-Z]{2}\d{8,}TH)/g;

  let m;
  while ((m = flashRx.exec(text)) !== null) results.add(m[1]);
  while ((m = emsRx.exec(text)) !== null) results.add(m[1]);

  return [...results];
}

// ──────────────────────────────────────────────
//  🤖 Claude Vision fallback สำหรับ image PDF
// ──────────────────────────────────────────────
async function parsePDFWithClaude(buffer) {
  const apiKey = process.env.ANTHROPIC_API_KEY;
  if (!apiKey) throw new Error('ไม่มี ANTHROPIC_API_KEY — กรุณาเพิ่มใน Vercel Environment Variables');

  const base64 = buffer.toString('base64');

  const res = await fetch('https://api.anthropic.com/v1/messages', {
    method: 'POST',
    headers: {
      'Content-Type':      'application/json',
      'x-api-key':         apiKey,
      'anthropic-version': '2023-06-01',
    },
    body: JSON.stringify({
      model:      'claude-haiku-4-5-20251001',
      max_tokens: 512,
      messages: [{
        role: 'user',
        content: [
          {
            type:   'document',
            source: { type: 'base64', media_type: 'application/pdf', data: base64 },
          },
          {
            type: 'text',
            text: `นี่คือบิลค่าส่งพัสดุ ดึงเฉพาะเลขพัสดุทุกเลข (เลขที่ขึ้นต้นด้วย TH หรือรูปแบบ EMS)
ตอบเป็น JSON array เท่านั้น เช่น ["TH01288WV4KA5B0","TH47158WUBVH8A"]
ถ้าไม่พบตอบ []`,
          },
        ],
      }],
    }),
  });

  if (!res.ok) {
    const err = await res.text();
    throw new Error('Claude API error: ' + err.slice(0, 200));
  }

  const json    = await res.json();
  const content = json?.content?.[0]?.text || '[]';
  console.log('Claude response:', content);

  try {
    const arr = JSON.parse(content.match(/\[[\s\S]*\]/)?.[0] || '[]');
    return arr.filter(t => typeof t === 'string' && t.length > 5);
  } catch (e) {
    console.error('JSON parse error:', e.message);
    return [];
  }
}

// ──────────────────────────────────────────────
//  📝 Format: แยกเป็น bubble ละ 1 เลขพัสดุ
// ──────────────────────────────────────────────
function formatTrackings(trackings) {
  if (trackings.length === 0) {
    return ['❌ ไม่พบเลขพัสดุในไฟล์นี้ค่ะ\nกรุณาตรวจสอบว่าส่งไฟล์ PDF บิลค่าส่งถูกต้องหรือไม่'];
  }

  return trackings.map((t, i) =>
    `📮 พัสดุที่ ${i + 1}/${trackings.length}\n${t}`
  );
}

module.exports = { parseBillPDF, formatTrackings };
